// ===========================================================================
//  secrets.h.example —— 本机专属配置的模板
//
//  用法：把这份文件复制成同目录下的 secrets.h，填上你自己的值。
//
//      copy secrets.h.example secrets.h        （Windows）
//      cp   secrets.h.example secrets.h        （macOS / Linux）
//
//  secrets.h 已经在 .gitignore 里，不会被提交。
//
//  ★ 不填也行。config.h 用 __has_include 引这个文件，没有就退回占位符，
//    然后靠**手机扫码配网**把账号写进板子（见 README「用手机扫码配网」）——
//    这是推荐做法，因为账号存在板子的 NVS 里，重新编译、整片擦除都不会丢。
//
//  ⚠️ 一旦这里写了真实值，它是编译期常量：板子上电先用 NVS 里的账号，
//    没有才用这里的。所以配过网之后，改这个文件对板子没影响。
// ===========================================================================
#pragma once

// ---- WiFi ----
// 注意：ESP32 只支持 2.4GHz，连不了 5G 频段。同一个路由器通常两个频段都有，
// 名字一般是 "你的WiFi" 和 "你的WiFi-5G"，要填**不带 -5G 的那个**。
#define WIFI_SSID       "你的WiFi名字"
#define WIFI_PASSWORD   "你的WiFi密码"

// ---- 可选：固定 IP（默认用 DHCP）----
// 想让 PC 端配置里写死 IP 就打开下面这行。前提是这个 IP 没被别的设备占用，
// 而且要在路由器的 DHCP 地址池之外。
// #define USE_STATIC_IP
#define STATIC_IP       "192.168.1.50"
#define STATIC_GW       "192.168.1.1"
#define STATIC_MASK     "255.255.255.0"
#define STATIC_DNS      "192.168.1.1"

// ---- 安全令牌：PC 端和板子必须一致（防止别人往板子乱发指令）----
// 改的话记得 pc/apps.json 里的 token 一起改。
#define LINK_TOKEN      "esp32launcher"
